# ---- Server (Vercel → Project → Settings → Environment Variables) ----

# Firebase Admin service-account JSON (Firebase Console → Project settings → Service accounts →
# Generate new private key). Paste the whole file contents. Never commit it.
FIREBASE_SERVICE_ACCOUNT=""
# Optional overrides (defaults match firebase-applet-config.json)
# FIREBASE_PROJECT_ID=""
# FIRESTORE_DATABASE_ID=""

# Comma-separated emails of the SaaS operators (see every organisation, activate plans, run the migration)
PLATFORM_ADMIN_EMAILS="you@yourcompany.com"

# Public URL of the app (used in invitation links and emails)
APP_URL="https://your-app.vercel.app"
APP_NAME="Meeting Room Booking"

# Email (Resend). MAIL_FROM must be on a domain verified in Resend; until then emails are only logged.
RESEND_API_KEY=""
MAIL_FROM="Meeting Rooms <meetings@yourdomain.com>"

# ---- Browser (Vite) ----
VITE_APP_NAME="Meeting Room Booking"
# Shown on the Plan page for customers who want to activate/upgrade
VITE_SUPPORT_EMAIL=""
