rules_version = '2';

// All data is read and written by the server (/api/v1) with the Firebase Admin SDK, which bypasses
// these rules after checking the user's organisation, role and subscription. Browsers get no direct access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
